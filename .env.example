# Copy to .env. Internal addresses are runtime deployment configuration.
REDIS_URL=redis://redis:6379/0
VERIFIER_URL=http://verifier:8001
PROVIDER_URL=http://provider-stub:8002
PROVIDER_MODE=stub
# Required only for OpenAI-compatible provider_mode=compatible:
PROVIDER_MODEL=
PROVIDER_API_KEY=
TOKEN_INPUT_PRICE=0
TOKEN_OUTPUT_PRICE=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
DATA_DIR=/data
CORPUS_DIR=corpus
PROMPT_VERSION=v2
CALL_TIMEOUT=5
MAX_RETRIES=2
MAX_STEPS=20
MAX_TOOL_CALLS=14
RUN_TIMEOUT=45
CACHE_ENABLED=true
CACHE_TTL=3600
RATE_LIMIT=60
RATE_WINDOW=60
STUB_DELAY=0.75
STUB_FAULT=none
ENABLE_FAULTS=false
# Keep false for real shipments until sources/amendments are confirmed.
POLICY_SNAPSHOT_CONFIRMED=false
QUALITY_SAMPLE_EVERY=5
APP_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_PORT=16686
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-demo-change-me
