{
  "Submission": {
    "$defs": {
      "Material": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "stainless_steel",
              "steel",
              "iron",
              "plastic",
              "glass",
              "wood",
              "other"
            ],
            "title": "Name",
            "type": "string"
          },
          "percent": {
            "exclusiveMinimum": 0,
            "maximum": 100,
            "title": "Percent",
            "type": "number"
          }
        },
        "required": [
          "name",
          "percent"
        ],
        "title": "Material",
        "type": "object"
      },
      "Product": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 2000,
            "minLength": 10,
            "title": "Description",
            "type": "string"
          },
          "intended_use": {
            "default": "",
            "maxLength": 300,
            "title": "Intended Use",
            "type": "string"
          },
          "materials": {
            "items": {
              "$ref": "#/$defs/Material"
            },
            "maxItems": 8,
            "title": "Materials",
            "type": "array"
          },
          "capacity_l": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 100,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Capacity L"
          },
          "vacuum_insulated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Vacuum Insulated"
          },
          "complete": {
            "default": true,
            "title": "Complete",
            "type": "boolean"
          },
          "destination": {
            "default": "US",
            "pattern": "^[A-Z]{2}$",
            "title": "Destination",
            "type": "string"
          },
          "quantity": {
            "default": 1,
            "maximum": 1000000,
            "minimum": 1,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "description"
        ],
        "title": "Product",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "product": {
        "$ref": "#/$defs/Product"
      },
      "prompt_version": {
        "default": "v2",
        "enum": [
          "v1",
          "v2"
        ],
        "title": "Prompt Version",
        "type": "string"
      },
      "cache": {
        "default": true,
        "title": "Cache",
        "type": "boolean"
      },
      "nonce": {
        "default": "",
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9_-]*$",
        "title": "Nonce",
        "type": "string"
      },
      "fault": {
        "default": "none",
        "enum": [
          "none",
          "unsupported",
          "timeout",
          "provider_down",
          "verifier_down"
        ],
        "title": "Fault",
        "type": "string"
      }
    },
    "required": [
      "product"
    ],
    "title": "Submission",
    "type": "object"
  },
  "Product": {
    "$defs": {
      "Material": {
