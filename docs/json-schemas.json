  "Recommendation": {
    "$defs": {
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "source",
          "page",
          "sha256"
        ],
        "title": "Citation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "heading": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Heading"
      },
      "tariff_item": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Tariff Item"
      },
      "rule": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rule"
      },
      "route": {
        "enum": [
          "clear-for-filing",
          "seek-product-clarification",
          "specialist-classification-review"
        ],
        "title": "Route",
        "type": "string"
      },
      "basis": {
        "title": "Basis",
        "type": "string"
      },
      "export_policy": {
        "default": "unconfirmed",
        "title": "Export Policy",
        "type": "string"
      },
      "citations": {
        "items": {
          "$ref": "#/$defs/Citation"
        },
        "title": "Citations",
        "type": "array"
      },
      "verified": {
        "default": false,
        "title": "Verified",
        "type": "boolean"
      },
      "proposed_only": {
        "default": true,
        "title": "Proposed Only",
        "type": "boolean"
      },
      "disclaimer": {
        "default": "Proposed classification only. A licensed customs broker decides; this service never files a declaration.",
        "title": "Disclaimer",
        "type": "string"
      },
      "prompt_version": {
        "title": "Prompt Version",
        "type": "string"
      },
      "mode": {
        "title": "Mode",
        "type": "string"
      },
      "entities": {
        "additionalProperties": true,
        "title": "Entities",
        "type": "object"
      },
      "cost_usd": {
        "default": 0,
        "title": "Cost Usd",
        "type": "number"
      },
      "prompt_tokens": {
        "default": 0,
        "title": "Prompt Tokens",
        "type": "integer"
      },
      "completion_tokens": {
        "default": 0,
        "title": "Completion Tokens",
        "type": "integer"
      },
      "cache_hit": {
        "default": false,
        "title": "Cache Hit",
        "type": "boolean"
      }
    },
    "required": [
      "route",
      "basis",
      "prompt_version",
      "mode"
    ],
    "title": "Recommendation",
    "type": "object"
  },
  "Feedback": {
    "additionalProperties": false,
    "properties": {
      "satisfactory": {
        "title": "Satisfactory",
        "type": "boolean"
      },
      "reason": {
        "maxLength": 500,
        "minLength": 3,
        "title": "Reason",
        "type": "string"
      }
    },
    "required": [
      "satisfactory",
      "reason"
    ],
    "title": "Feedback",
    "type": "object"
  },
