{
  "openapi": "3.1.0",
  "info": {
    "title": "Export Classification Check Service",
    "description": "Asynchronous proposed classifications for chapters 73/96. A broker decides. Polling avoids callback SSRF and client availability dependencies.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_v1_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{rid}": {
      "get": {
        "summary": "Status",
        "operationId": "status_v1_runs__rid__get",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{rid}/trace": {
      "get": {
        "summary": "Audit",
        "operationId": "audit_v1_runs__rid__trace_get",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{rid}/feedback": {
      "post": {
        "summary": "Feedback",
        "operationId": "feedback_v1_runs__rid__feedback_post",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackReceipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics": {
      "get": {
        "summary": "Analytics",
        "operationId": "analytics_v1_analytics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/corpus": {
      "get": {
        "summary": "Corpus",
        "operationId": "corpus_v1_corpus_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "trace_url": {
            "type": "string",
            "title": "Trace Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "status_url",
          "trace_url"
        ],
        "title": "Accepted"
      },
      "AnalyticsResponse": {
        "properties": {
          "feedback_count": {
            "type": "integer",
            "title": "Feedback Count"
          },
          "satisfactory_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Satisfactory Rate"
          },
          "quality": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Quality"
          },
          "quarantine_count": {
            "type": "integer",
            "title": "Quarantine Count"
          },
          "breaker_open_until": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Breaker Open Until"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feedback_count",
          "satisfactory_rate",
          "quality",
          "quarantine_count",
          "breaker_open_until"
        ],
        "title": "AnalyticsResponse"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "source",
          "page",
          "sha256"
        ],
        "title": "Citation"
      },
      "CorpusResponse": {
        "properties": {
          "digest": {
            "type": "string",
            "title": "Digest"
          },
          "built_at": {
            "type": "number",
            "title": "Built At"
          },
          "chunks": {
            "type": "integer",
            "title": "Chunks"
          },
          "new_embeddings": {
            "type": "integer",
            "title": "New Embeddings"
          },
          "embedding": {
            "type": "string",
            "title": "Embedding"
          },
          "chunks_per_second": {
            "type": "number",
            "title": "Chunks Per Second"
          },
          "sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "digest",
          "built_at",
          "chunks",
          "new_embeddings",
          "embedding",
          "chunks_per_second",
          "sources"
        ],
        "title": "CorpusResponse"
      },
      "Feedback": {
        "properties": {
          "satisfactory": {
            "type": "boolean",
            "title": "Satisfactory"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "satisfactory",
          "reason"
        ],
        "title": "Feedback"
      },
      "FeedbackReceipt": {
        "properties": {
          "persisted": {
            "type": "boolean",
            "title": "Persisted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "persisted"
        ],
        "title": "FeedbackReceipt"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "corpus": {
            "type": "string",
            "title": "Corpus"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "corpus",
          "mode"
        ],
        "title": "HealthResponse"
      },
      "Material": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "stainless_steel",
              "steel",
              "iron",
              "plastic",
              "glass",
              "wood",
              "other"
            ],
            "title": "Name"
          },
          "percent": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Percent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "percent"
        ],
        "title": "Material"
      },
      "Product": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Description"
          },
          "intended_use": {
            "type": "string",
            "maxLength": 300,
            "title": "Intended Use",
            "default": ""
          },
          "materials": {
            "items": {
              "$ref": "#/components/schemas/Material"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Materials"
          },
          "capacity_l": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Capacity L"
          },
          "vacuum_insulated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vacuum Insulated"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete",
            "default": true
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Destination",
            "default": "US"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "description"
        ],
        "title": "Product"
      },
      "Recommendation": {
        "properties": {
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "tariff_item": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tariff Item"
          },
          "rule": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule"
          },
          "route": {
            "type": "string",
            "enum": [
              "clear-for-filing",
              "seek-product-clarification",
              "specialist-classification-review"
            ],
            "title": "Route"
          },
          "basis": {
            "type": "string",
            "title": "Basis"
          },
          "export_policy": {
            "type": "string",
            "title": "Export Policy",
            "default": "unconfirmed"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "default": false
          },
          "proposed_only": {
            "type": "boolean",
            "title": "Proposed Only",
            "default": true
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "Proposed classification only. A licensed customs broker decides; this service never files a declaration."
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "entities": {
            "additionalProperties": true,
            "type": "object",
            "title": "Entities"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0
          },
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "default": 0
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens",
            "default": 0
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "route",
          "basis",
          "prompt_version",
          "mode"
        ],
        "title": "Recommendation"
      },
      "RunStatus": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "escalated"
            ],
            "title": "Status"
          },
          "submitted_at": {
            "type": "number",
            "title": "Submitted At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Recommendation"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          },
          "request": {
            "$ref": "#/components/schemas/Submission"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "status",
          "submitted_at",
          "correlation_id",
          "request"
        ],
        "title": "RunStatus"
      },
      "Submission": {
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "prompt_version": {
            "type": "string",
            "enum": [
              "v1",
              "v2"
            ],
            "title": "Prompt Version",
            "default": "v2"
          },
          "cache": {
            "type": "boolean",
            "title": "Cache",
            "default": true
          },
          "nonce": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "title": "Nonce",
            "default": ""
          },
          "fault": {
            "type": "string",
            "enum": [
              "none",
              "unsupported",
              "timeout",
              "provider_down",
              "verifier_down"
            ],
            "title": "Fault",
            "default": "none"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product"
        ],
        "title": "Submission"
      },
      "TraceResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "events"
        ],
        "title": "TraceResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}